# HeartConnect — local environment
#
# There are two ways to run this, and they use the same three variables.
#
#   1. Against the local Supabase stack (no account, no network, real Postgres
#      with RLS). Recommended for development. See "Local stack" below.
#   2. Against a hosted Supabase project. Copy to `.env` and fill in from
#      Project Settings → API:
#         cp .env.example .env
#
# `.env` and `.env.local` are both git-ignored. Never commit real values.

# ---------------------------------------------------------------------------
# Required. The app renders a configuration error screen and refuses to boot
# without both of these (see src/lib/supabaseConfig.ts).
# ---------------------------------------------------------------------------

# Project URL. Hosted: https://abcdefghijklm.supabase.co
# Local:           http://127.0.0.1:54321
VITE_SUPABASE_URL=

# The *anon / publishable* key. This is the only key that may ever reach the
# browser: anything prefixed VITE_ is inlined into the public bundle.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Local stack
# ---------------------------------------------------------------------------
# `supabase start` brings up Postgres, PostgREST and GoTrue on one port. The
# publishable key it prints is a *local* key with no access to anything outside
# this machine, so it is safe to commit — but it is still written to
# `.env.local` rather than here, so that one file can be regenerated with
# `supabase status` without touching this template.
#
#   cp .env.example .env.local    # then run: supabase status
#
# `.env.local` takes precedence over `.env` in Vite, so a local stack and a
# hosted project can coexist in one checkout.
#
# Start and reset:
#   supabase start
#   supabase db reset        # migrations + supabase/seed.sql from zero
#   supabase test db         # pgTAP suite in supabase/tests/
#
# Seeded sign-in for manual testing: demo@local.test / Demo-Local-2026

# ---------------------------------------------------------------------------
# Optional.
# ---------------------------------------------------------------------------

# Absolute origin the app is served from. Used only to build the password-reset
# redirect URL. Leave blank to use whatever origin the browser is on.
VITE_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# NEVER add the service_role (secret) key under any VITE_ name. VITE_-prefixed
# variables are inlined into the JavaScript served to every visitor, which would
# hand your database full read/write access. RLS is the only thing standing
# between a leaked anon key and your data.
# ---------------------------------------------------------------------------
